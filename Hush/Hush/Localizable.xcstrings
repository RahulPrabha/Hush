{
  "sourceLanguage" : "en",
  "strings" : {
    "Allow Hush in Login Items to finish." : {
      "comment" : "Hint shown when macOS needs the user to approve Hush as a login item in System Settings",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Hush unter „Anmeldeobjekte“, um den Vorgang abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite Hush en Ítems de inicio para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Hush dans Ouverture pour terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
